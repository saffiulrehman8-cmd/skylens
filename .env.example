# Local dev: copy to .env.  Netlify: set the same names in
# Site configuration > Environment variables (scope: Functions). Never commit .env.
PORT=3000
OWM_API_KEY=your_openweather_key
MONGO_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/skylens
JWT_SECRET=use_a_long_random_string_here
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=https://YOUR-SITE.netlify.app
